{
    "name": "@jhaz-imprints/catalog-service",
    "version": "0.0.1",
    "private": true,
    "description": "Express API for Catalog Microservice",
    "type": "module",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsup src/server.ts --format esm --clean",
        "start": "node dist/server.js",
        "type-check": "tsc --noEmit",
        "lint": "tsc --noEmit",
        "test": "vitest"
    },
    "dependencies": {
        "@jhaz-imprints/catalog-db": "workspace:*",
        "@jhaz-imprints/shared": "workspace:*",
        "cloudinary": "^2.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "express-rate-limit": "^8.4.1",
        "helmet": "^8.1.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.1.0",
        "mongoose-paginate-v2": "^1.7.31",
        "multer": "1.4.5-lts.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.11.0",
        "tsup": "^8.5.1",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    }
}