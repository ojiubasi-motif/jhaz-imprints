// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
  CUSTOMER
  ADMIN
  TAILOR
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Models
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  phone     String?
  firstName String?
  lastName  String?
  password  String
  role      Role     @default(CUSTOMER)
  refreshToken String?

  // ── Brute-force lockout fields ────────────────────────────────────────────
  // SECURITY: Per-account lockout independent of IP-based rate limiting.
  // OWASP Authentication CS — Login Throttling / Account Lockout.
  // failedLoginAttempts is reset to 0 on every successful login.
  // lockedUntil is set to a future DateTime after threshold breaches:
  //   ≥5  failures  → 15-minute lock
  //   ≥10 failures  → 1-hour lock
  //   ≥20 failures  → permanent lock (admin intervention required)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // ── Password reset fields (OWASP Forgot Password CS) ─────────────────────
  // SECURITY:
  //   - resetPasswordToken stores a SHA-256 HASH of the raw token (never raw).
  //     If the DB is compromised, attackers cannot use stored hashes directly.
  //   - resetPasswordExpires enforces a 15-minute TTL on the token.
  //   - Both are nulled after use (single-use enforcement).
  //   - @unique on the hash ensures no two users can have the same token.
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  // ── Last login and Admin OTP fields ───────────────────────────────────────
  lastLoginAt          DateTime?
  lastLoginIp          String?
  adminOtpHash         String?
  adminOtpExpires      DateTime?

  measurements    Measurement[]
  orders          Order[]

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Measurement {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Profile data
  profileName String  @default("Default")
  isDefault   Boolean @default(false)
  
  // Measurements in cm
  chest       Float?
  waist       Float?
  hip         Float?
  shoulder    Float?
  armLength   Float?
  length      Float?
  
  // Additional notes
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // One measurement can be referenced by many orders (snapshot at order time)
  orders      Order[]
}

model Order {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Measurement is now stored inline inside the items JSON array.
  // The FK is retained for backward-compatibility with pre-migration orders.
  measurementId       String?
  measurement         Measurement? @relation(fields: [measurementId], references: [id])
  
  // Array of items (customization details) stored as Json
  // e.g. [{ productId, styleOptionName, fabricOptionName, colorName, basePrice, styleModifier, fabricModifier, notes }]
  items               Json
  
  // Order metadata
  status              OrderStatus @default(PENDING)
  totalAmount         Float
  currency            String   @default("NGN")
  
  // Optional order notes (garment details, special requests)
  notes               String?
  
  // Timestamps
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  payment             Payment?
  statusHistory       OrderStatusHistory[]
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique  // Unique constraint for idempotency
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Payment details
  amount      Float
  currency    String      @default("NGN")
  status      PaymentStatus @default(PENDING)
  
  // Reference for idempotency and reconciliation
  reference   String   @unique // e.g., payment provider's transaction ID
  provider    String   @default("STRIPE") // STRIPE, PAYSTACK, etc.
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OrderStatusHistory {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Status transition
  status      OrderStatus
  note        String?  // e.g., tailor's production notes
  
  createdAt   DateTime @default(now())
}

// ==========================================
// MATERIALIZED VIEW (EVENT REPLICATION)
// ==========================================
model CachedProduct {
  id              String   @id // Corresponds to MongoDB ObjectId
  slug            String   @unique
  name            String
  basePrice       Float
  isActive        Boolean  @default(true)
  
  // Stored as JSON arrays to simplify local calculation without relational overhead
  fabricOptions   Json     // [{ name: string, priceModifier: number }]
  styleOptions    Json     // [{ name: string, priceModifier: number }]
  colorOptions    Json     // [{ name: string, inStock: boolean }]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
